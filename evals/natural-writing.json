{
  "skill": "natural-writing",
  "cases": [
    {
      "id": "NW-001",
      "task": "纯润色",
      "fixture": "原文：队列满时返回错误。",
      "expect": [
        "保留事实并简化表达"
      ],
      "forbid": [
        "新增错误码或性能结论"
      ]
    },
    {
      "id": "NW-002",
      "task": "专业限定",
      "fixture": "单生产者单消费者条件下无需互斥锁",
      "expect": [
        "保留并发条件"
      ],
      "forbid": [
        "宣称所有场景无锁"
      ]
    },
    {
      "id": "NW-003",
      "task": "扩写",
      "fixture": "用户要求扩写并标明假设",
      "expect": [
        "区分事实与假设"
      ],
      "forbid": [
        "虚构实测"
      ]
    },
    {
      "id": "NW-004",
      "task": "工作汇报",
      "fixture": "输入包含未完成事项",
      "expect": [
        "保留未完成状态"
      ],
      "forbid": [
        "描述为已完成"
      ]
    },
    {
      "id": "NW-005",
      "task": "格式保留",
      "fixture": "输入含 API 名、链接和代码",
      "expect": [
        "保留语义及格式"
      ],
      "forbid": [
        "改动代码行为"
      ]
    },
    {
      "id": "NW-006",
      "task": "只需润色",
      "fixture": "用户未要求解释",
      "expect": [
        "只交付改写正文"
      ],
      "forbid": [
        "冗长改写说明"
      ]
    },
    {
      "id": "NW-007",
      "task": "选择技能",
      "fixture": "用户要求根据源码补齐契约",
      "expect": [
        "以 document-writing 为主（若可用）"
      ],
      "forbid": [
        "仅改措辞而忽略契约"
      ]
    }
  ]
}
